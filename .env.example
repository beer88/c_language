# Server Settings
PORT=3000
BASE_URL=http://localhost:3000

# Database Configuration
# Leave blank to use SQLite, or provide a PostgreSQL connection URL
DATABASE_URL=postgres://user:password@host:port/dbname

# JWT Secrets for Authentication
JWT_SECRET=your_user_jwt_secret_key_here
ADMIN_JWT_SECRET=your_admin_jwt_secret_key_here

# Admin Login Credentials
ADMIN_EMAIL=admin@stemflyrobotics.in
ADMIN_PASSWORD=Admin@123

# Cashfree PG Payment Credentials (Sandbox / Production)
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENVIRONMENT=TEST

# Safety Flags
ALLOW_SEED=false
